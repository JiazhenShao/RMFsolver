# Track research sources, notebooks, manuscripts, figures, references, and data.
# Ignore only local environments, caches, logs, credentials, and UI state.

# This workspace also contains a Python virtual environment.
/bin/
/lib/
/include/
/share/
/etc/
/pyvenv.cfg
.venv/
venv/
*.egg-info/

# Python and notebook caches
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.mpl-cache/

# Machine-local assistant state and credentials
/.claude/
/.codex/
/.aws/
.env
.env.*
!.env.example
!.env.template
*.pem
*.key

# Temporary files and logs
/tmp/
/.tmp_*
*.log
.DS_Store

# Keep shared Obsidian configuration, but not per-machine UI state.
/.obsidian/workspace.json
/.obsidian/workspace-mobile.json
/wiki/.obsidian/workspace.json
/wiki/.obsidian/workspace-mobile.json
