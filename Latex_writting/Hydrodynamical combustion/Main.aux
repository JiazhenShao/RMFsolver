\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces  \textsf  {\color  {blue}[\textsuperscript  {LB}In the isothermal case does the upper grey region curve back down at high T(0-)? I suspect not.]}\textsf  {\color  {violet} [\textsuperscript  {JS}No it doesn't]} Full numerical phase-boundary speed $u(0^-)$ in $\text  {m}\,\text  {s}^{-1}$ as a function of the upstream baryon density and temperature, with $T(0^+)=0.1\,\text  {MeV}$ and $n_B^{\rm  crit}(T{=}0)=3n_0\,.$ The white band is the domain in which the moving-front solution exists. Below the lower boundary neutron matter is stable against the assumed conversion, while the region marked $A\geq 1$ lies outside the weak-interaction-limited branch described by our model. The contours are drawn at $50\,,$ $100\,,$ $200\,,$ $500\,,$ $1000\,,$ $2000\,,$ and $5000\,\text  {m}\,\text  {s}^{-1}\,.$}}{10}{figure.caption.21}\protected@file@percent }
\newlabel{fig:numerical}{{5}{10}{\LBcom {In the isothermal case does the upper grey region curve back down at high T(0-)? I suspect not.}\JScom {No it doesn't} Full numerical phase-boundary speed $u(0^-)$ in $\m \,\s ^{-1}$ as a function of the upstream baryon density and temperature, with $T(0^+)=0.1\,\MeV $ and $n_B^{\rm crit}(T{=}0)=3n_0\,.$ The white band is the domain in which the moving-front solution exists. Below the lower boundary neutron matter is stable against the assumed conversion, while the region marked $A\geq 1$ lies outside the weak-interaction-limited branch described by our model. The contours are drawn at $50\,,$ $100\,,$ $200\,,$ $500\,,$ $1000\,,$ $2000\,,$ and $5000\,\m \,\s ^{-1}\,.$}{figure.caption.21}{}}
\newlabel{fig:u-analytical-loglog}{{5}{10}{\LBcom {In the isothermal case does the upper grey region curve back down at high T(0-)? I suspect not.}\JScom {No it doesn't} Full numerical phase-boundary speed $u(0^-)$ in $\m \,\s ^{-1}$ as a function of the upstream baryon density and temperature, with $T(0^+)=0.1\,\MeV $ and $n_B^{\rm crit}(T{=}0)=3n_0\,.$ The white band is the domain in which the moving-front solution exists. Below the lower boundary neutron matter is stable against the assumed conversion, while the region marked $A\geq 1$ lies outside the weak-interaction-limited branch described by our model. The contours are drawn at $50\,,$ $100\,,$ $200\,,$ $500\,,$ $1000\,,$ $2000\,,$ and $5000\,\m \,\s ^{-1}\,.$}{figure.caption.21}{}}
\newlabel{fig:T_vs_nB0-}{{5}{10}{\LBcom {In the isothermal case does the upper grey region curve back down at high T(0-)? I suspect not.}\JScom {No it doesn't} Full numerical phase-boundary speed $u(0^-)$ in $\m \,\s ^{-1}$ as a function of the upstream baryon density and temperature, with $T(0^+)=0.1\,\MeV $ and $n_B^{\rm crit}(T{=}0)=3n_0\,.$ The white band is the domain in which the moving-front solution exists. Below the lower boundary neutron matter is stable against the assumed conversion, while the region marked $A\geq 1$ lies outside the weak-interaction-limited branch described by our model. The contours are drawn at $50\,,$ $100\,,$ $200\,,$ $500\,,$ $1000\,,$ $2000\,,$ and $5000\,\m \,\s ^{-1}\,.$}{figure.caption.21}{}}
