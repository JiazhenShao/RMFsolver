\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Dependence of the numerical phase-boundary speed on the prescribed interface temperature $T(0^+)$. Panel (a) shows $u(0^-)$ as a function of $n_B(0^-)$ at fixed $T(0^-)=20\,\text  {MeV}$, while panel (b) shows $u(0^-)$ as a function of $T(0^-)$ at fixed $n_B(0^-)=3.5n_0$. The velocity axis is logarithmic, the markers denote the numerical slice samples, and the line color runs from colder (purple and blue) to hotter (red) values of $T(0^+)$. The gray regions are excluded in the corresponding slice by stable neutron matter or by $A\geq 1$.}}{14}{figure.caption.32}\protected@file@percent }
\newlabel{fig:numerical-contour-compare}{{8}{14}{Dependence of the numerical phase-boundary speed on the prescribed interface temperature $T(0^+)$. Panel (a) shows $u(0^-)$ as a function of $n_B(0^-)$ at fixed $T(0^-)=20\,\MeV $, while panel (b) shows $u(0^-)$ as a function of $T(0^-)$ at fixed $n_B(0^-)=3.5n_0$. The velocity axis is logarithmic, the markers denote the numerical slice samples, and the line color runs from colder (purple and blue) to hotter (red) values of $T(0^+)$. The gray regions are excluded in the corresponding slice by stable neutron matter or by $A\geq 1$}{figure.caption.32}{}}
