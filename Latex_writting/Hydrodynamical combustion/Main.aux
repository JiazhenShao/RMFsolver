\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces  Full numerical phase-boundary speed $u(0^-)$ in $\text  {m}\,\text  {s}^{-1}$ as a function of the upstream baryon density and temperature, with $T(0^+)=0.1\,\text  {MeV}$ and $n_B^{\rm  crit}(T{=}0)=3n_0\,.$ The white band is the domain in which the moving-front solution exists. Below the lower boundary neutron matter is stable against the assumed conversion, while the region marked $A\geq 1$ lies outside the weak-interaction-limited branch described by our model. The contours are drawn at $50\,,$ $100\,,$ $200\,,$ $500\,,$ $1000\,,$ $2000\,,$ and $5000\,\text  {m}\,\text  {s}^{-1}\,.$}}{10}{figure.caption.21}\protected@file@percent }
\newlabel{fig:numerical}{{5}{10}{Full numerical phase-boundary speed $u(0^-)$ in $\m \,\s ^{-1}$ as a function of the upstream baryon density and temperature, with $T(0^+)=0.1\,\MeV $ and $n_B^{\rm crit}(T{=}0)=3n_0\,.$ The white band is the domain in which the moving-front solution exists. Below the lower boundary neutron matter is stable against the assumed conversion, while the region marked $A\geq 1$ lies outside the weak-interaction-limited branch described by our model. The contours are drawn at $50\,,$ $100\,,$ $200\,,$ $500\,,$ $1000\,,$ $2000\,,$ and $5000\,\m \,\s ^{-1}\,.$}{figure.caption.21}{}}
\newlabel{fig:u-analytical-loglog}{{5}{10}{Full numerical phase-boundary speed $u(0^-)$ in $\m \,\s ^{-1}$ as a function of the upstream baryon density and temperature, with $T(0^+)=0.1\,\MeV $ and $n_B^{\rm crit}(T{=}0)=3n_0\,.$ The white band is the domain in which the moving-front solution exists. Below the lower boundary neutron matter is stable against the assumed conversion, while the region marked $A\geq 1$ lies outside the weak-interaction-limited branch described by our model. The contours are drawn at $50\,,$ $100\,,$ $200\,,$ $500\,,$ $1000\,,$ $2000\,,$ and $5000\,\m \,\s ^{-1}\,.$}{figure.caption.21}{}}
\newlabel{fig:T_vs_nB0-}{{5}{10}{Full numerical phase-boundary speed $u(0^-)$ in $\m \,\s ^{-1}$ as a function of the upstream baryon density and temperature, with $T(0^+)=0.1\,\MeV $ and $n_B^{\rm crit}(T{=}0)=3n_0\,.$ The white band is the domain in which the moving-front solution exists. Below the lower boundary neutron matter is stable against the assumed conversion, while the region marked $A\geq 1$ lies outside the weak-interaction-limited branch described by our model. The contours are drawn at $50\,,$ $100\,,$ $200\,,$ $500\,,$ $1000\,,$ $2000\,,$ and $5000\,\m \,\s ^{-1}\,.$}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Remaining distance $z(t)$ to the zero-speed surface, obtained from the full numerical speed map at fixed $T(0^+)=5\,\text  {MeV}\,.$ The initial distance is $z_0=1\,\text  {km}\,,$ and the assumed density gradient is $0.3n_0\,\text  {km}^{-1}\,.$ The points mark the fitted catch-up times for $T(0^-)=0\,,$ $20\,,$ $40\,,$ and $60\,\text  {MeV}\,.$ \textsf  {\color  {blue}[\textsuperscript  {LB}I thought we were not including this figure? ]}}}{10}{figure.caption.22}\protected@file@percent }
\newlabel{fig:z(t)}{{6}{10}{Remaining distance $z(t)$ to the zero-speed surface, obtained from the full numerical speed map at fixed $T(0^+)=5\,\MeV \,.$ The initial distance is $z_0=1\,\km \,,$ and the assumed density gradient is $0.3n_0\,\km ^{-1}\,.$ The points mark the fitted catch-up times for $T(0^-)=0\,,$ $20\,,$ $40\,,$ and $60\,\MeV \,.$ \LBcom {I thought we were not including this figure? }}{figure.caption.22}{}}
