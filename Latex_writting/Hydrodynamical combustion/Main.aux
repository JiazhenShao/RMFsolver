\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Constant-pressure trajectory through the quark conversion layer. The red curve is the energy-conserving numerical profile for $T(0^-)=10~{\rm  MeV}\,,$ $B^{1/4}=180~{\rm  MeV}\,,$ $n_B(0^-)=3n_0\,,$ and $a(0^+)=0.55$; the dashed curve is the quarter ellipse in Eq.~\eqref  {eq:constant_pressure_path}. The profile runs from the just-deconfined state at $x=0^+$ to the equilibrated state at $x\to \infty \,.$ The point $(A,0)$ is the zero-temperature endpoint of the extrapolated isobar and need not coincide with the state at $x=0^+\,.$ \textsf  {\color  {blue}[\textsuperscript  {LB}Why choose a+=0.55? Why not either choose a+ such that T+=T- (if this is possible) or choose a+ such that T-=0.1 MeV.]}}}{8}{figure.caption.18}\protected@file@percent }
\newlabel{fig:isobar_a_T}{{4}{8}{Constant-pressure trajectory through the quark conversion layer. The red curve is the energy-conserving numerical profile for $T(0^-)=10~{\rm MeV}\,,$ $B^{1/4}=180~{\rm MeV}\,,$ $n_B(0^-)=3n_0\,,$ and $a(0^+)=0.55$; the dashed curve is the quarter ellipse in Eq.~\eqref {eq:constant_pressure_path}. The profile runs from the just-deconfined state at $x=0^+$ to the equilibrated state at $x\to \infty \,.$ The point $(A,0)$ is the zero-temperature endpoint of the extrapolated isobar and need not coincide with the state at $x=0^+\,.$ \LBcom {Why choose a+=0.55? Why not either choose a+ such that T+=T- (if this is possible) or choose a+ such that T-=0.1 MeV.}}{figure.caption.18}{}}
\newlabel{eq:speed_modified}{{42}{8}{}{equation.4.42}{}}
