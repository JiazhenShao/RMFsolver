\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Remaining distance $z(t)$ to the zero-speed surface, obtained from the full numerical speed map at fixed $T(0^+)=5\,\text  {MeV}\,.$ The initial distance is $z_0=1\,\text  {km}\,,$ and the assumed density gradient is $0.3n_0\,\text  {km}^{-1}\,.$ The points mark the fitted catch-up times for $T(0^-)=0\,,$ $20\,,$ $40\,,$ and $60\,\text  {MeV}\,.$}}{10}{figure.caption.23}\protected@file@percent }
\newlabel{fig:z(t)}{{6}{10}{Remaining distance $z(t)$ to the zero-speed surface, obtained from the full numerical speed map at fixed $T(0^+)=5\,\MeV \,.$ The initial distance is $z_0=1\,\km \,,$ and the assumed density gradient is $0.3n_0\,\km ^{-1}\,.$ The points mark the fitted catch-up times for $T(0^-)=0\,,$ $20\,,$ $40\,,$ and $60\,\MeV \,.$}{figure.caption.23}{}}
