\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  \textsf  {\color  [rgb]{0.8,0,0}[\textsuperscript  {MGA} Now that we are doing isothermal and adiabatic cases, we either need different versions of this figure, or drop it.]} Schematic illustration of the expected boundary profile. Note the discontinuities in some thermodynamic properties at the phase boundary located at $x=0$, followed by relaxation to beta equilibrium as $x\to \infty $. }}{2}{figure.caption.5}\protected@file@percent }
\newlabel{fig:boundary_schematic}{{2}{2}{\mgacom {Now that we are doing isothermal and adiabatic cases, we either need different versions of this figure, or drop it.} Schematic illustration of the expected boundary profile. Note the discontinuities in some thermodynamic properties at the phase boundary located at $x=0$, followed by relaxation to beta equilibrium as $x\to \infty $}{figure.caption.5}{}}
