\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Pressure comparison between phases at some arbitrary temperature. Above pressure $P_\beta $, 3-flavor chemically equilibrated quark matter is favored over nuclear matter. At $P>P_\text  {2-flav}$, quark matter with the same flavor content as nuclear matter becomes favored, so weak interactions are no longer required for the conversion of nuclear to quark matter. }}{2}{figure.caption.4}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pressure-mu}{{1}{2}{Pressure comparison between phases at some arbitrary temperature. Above pressure $P_\be $, 3-flavor chemically equilibrated quark matter is favored over nuclear matter. At $P>P_\text {2-flav}$, quark matter with the same flavor content as nuclear matter becomes favored, so weak interactions are no longer required for the conversion of nuclear to quark matter}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  Schematic illustration of the expected boundary profile. Note the discontinuities in some thermodynamic properties at the phase boundary located at $x=0$, followed by relaxation to beta equilibrium as $x\to \infty $. {\color  [rgb]{0.6,0,0}In the adiabatic case, temperature will also show a discontinuity at $x=0$ followed by relaxation to an asymptotic value as $x\to \infty $.} }}{2}{figure.caption.5}\protected@file@percent }
\newlabel{fig:boundary_schematic}{{2}{2}{Schematic illustration of the expected boundary profile. Note the discontinuities in some thermodynamic properties at the phase boundary located at $x=0$, followed by relaxation to beta equilibrium as $x\to \infty $. \mga {In the adiabatic case, temperature will also show a discontinuity at $x=0$ followed by relaxation to an asymptotic value as $x\to \infty $.}}{figure.caption.5}{}}
