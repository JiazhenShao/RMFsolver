\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Constant-pressure trajectory through the quark conversion layer. The red curve is the energy-conserving numerical profile for $T(0^-)=10~{\rm  MeV}\,,$ $B^{1/4}=180~{\rm  MeV}\,,$ $n_B(0^-)=3n_0\,,$ and $a(0^+)=0.55$; the dashed curve is the quarter ellipse in Eq.~\eqref  {eq:constant_pressure_path}. The profile runs from the just-deconfined state at $x=0^+$ to the equilibrated state at $x\to \infty \,.$ The point $(A,0)$ is the zero-temperature endpoint of the extrapolated isobar and need not coincide with the state at $x=0^+\,.$}}{8}{figure.caption.18}\protected@file@percent }
\newlabel{fig:constant_pressure_trajectory}{{4}{8}{Constant-pressure trajectory through the quark conversion layer. The red curve is the energy-conserving numerical profile for $T(0^-)=10~{\rm MeV}\,,$ $B^{1/4}=180~{\rm MeV}\,,$ $n_B(0^-)=3n_0\,,$ and $a(0^+)=0.55$; the dashed curve is the quarter ellipse in Eq.~\eqref {eq:constant_pressure_path}. The profile runs from the just-deconfined state at $x=0^+$ to the equilibrated state at $x\to \infty \,.$ The point $(A,0)$ is the zero-temperature endpoint of the extrapolated isobar and need not coincide with the state at $x=0^+\,.$}{figure.caption.18}{}}
