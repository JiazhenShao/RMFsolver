%% ADD ABBREVIATIONS for color-highlighted edits %%

\newcommand{\authorname}[1]{{\color{blue}{\textsuperscript{AUTHOR1}#1}}}
%Example: \newcommand{\lb}[1]{{\color{blue}{\textsuperscript{LB}#1}}}

% Adding comments to the text:
\newcommand{\com}[1]{{\sf\color[rgb]{0,0,1}[#1]}}

% Marking old and new text:
\newcommand{\old}[1]{{\color[rgb]{0.7,0.7,0.7}\sout{#1}}}
\newcommand{\new}[1]{{\color[rgb]{0.7,0,0.7}#1}}


