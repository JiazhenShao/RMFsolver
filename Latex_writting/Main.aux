\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Constant-pressure trajectory through the quark conversion layer {\color  [rgb]{0.6,0,0}in the adiabatic case, for $T(0^-)=10~\text  {MeV}$, $B^{1/4}=180~\text  {MeV}$, $n_B(0^-)=3n_0$, and $a(0^+)=0.55$. The red curve is from the profile obtained by numerically solving the K flux equation.} The dashed curve is the quarter ellipse from the analytic approximation Eq.~\eqref  {eq:constant_pressure_path}. \textsf  {\color  [rgb]{0.8,0,0}[\textsuperscript  {MGA} The detailed description can be in the main text. The dashed curve should be labeled "analytic approx" and the red curve should be labeled "numerical solution". The place where the dashed curve meets the $x$ axis should be labeled $A_\text  {adb}$.]} }}{8}{figure.caption.18}\protected@file@percent }
\newlabel{fig:isobar_a_T}{{4}{8}{Constant-pressure trajectory through the quark conversion layer \mga {in the adiabatic case, for $T(0^-)=10~\MeV $, $B^{1/4}=180~\MeV $, $n_B(0^-)=3n_0$, and $a(0^+)=0.55$. The red curve is from the profile obtained by numerically solving the K flux equation.} The dashed curve is the quarter ellipse from the analytic approximation Eq.~\eqref {eq:constant_pressure_path}. \mgacom {The detailed description can be in the main text. The dashed curve should be labeled "analytic approx" and the red curve should be labeled "numerical solution". The place where the dashed curve meets the $x$ axis should be labeled $A_\text {adb}$.}}{figure.caption.18}{}}
