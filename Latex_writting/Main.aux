\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Pressure comparison between phases at some arbitrary temperature. \textsf  {\color  [rgb]{0.8,0,0}[\textsuperscript  {MGA} Maybe there shouldn't be a 2-flav line, since it's not an equilibrated phase with a definite composition at given $\mu _B$. We could just show the $P_\text  {2-flav}$ dashed line.]} Above pressure $P_\beta $, 3-flavor chemically equilibrated quark matter is favored over nuclear matter. At $P>P_\text  {2-flav}$, quark matter with the same flavor content as nuclear matter becomes favored, so weak interactions are no longer required for the conversion of nuclear to quark matter. }}{2}{figure.caption.4}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pressure-mu}{{1}{2}{Pressure comparison between phases at some arbitrary temperature. \mgacom {Maybe there shouldn't be a 2-flav line, since it's not an equilibrated phase with a definite composition at given $\mu _B$. We could just show the $P_\text {2-flav}$ dashed line.} Above pressure $P_\be $, 3-flavor chemically equilibrated quark matter is favored over nuclear matter. At $P>P_\text {2-flav}$, quark matter with the same flavor content as nuclear matter becomes favored, so weak interactions are no longer required for the conversion of nuclear to quark matter}{figure.caption.4}{}}
