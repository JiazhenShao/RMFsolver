\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces  Full numerical phase-boundary speed $u(0^-)$ in $\text  {m}\,\text  {s}^{-1}$ as a function of the upstream baryon density and temperature, with $T(0^+)=0.1\,\text  {MeV}$ and $n_B^{\rm  crit}(T{=}0)=3n_0\,.$ The white band is the domain in which the moving-front solution exists. Below the lower boundary neutron matter is stable against the assumed conversion, while the region with $A_{\rm  adb}\geq 1$ lies outside the weak-interaction-limited branch described by our model. The contours are drawn at $50\,,$ $100\,,$ $200\,,$ $500\,,$ $1000\,,$ $2000\,,$ and $5000\,\text  {m}\,\text  {s}^{-1}\,.$}}{9}{figure.caption.24}\protected@file@percent }
\newlabel{fig:numerical}{{8}{9}{Full numerical phase-boundary speed $u(0^-)$ in $\m \,\s ^{-1}$ as a function of the upstream baryon density and temperature, with $T(0^+)=0.1\,\MeV $ and $n_B^{\rm crit}(T{=}0)=3n_0\,.$ The white band is the domain in which the moving-front solution exists. Below the lower boundary neutron matter is stable against the assumed conversion, while the region with $A_{\rm adb}\geq 1$ lies outside the weak-interaction-limited branch described by our model. The contours are drawn at $50\,,$ $100\,,$ $200\,,$ $500\,,$ $1000\,,$ $2000\,,$ and $5000\,\m \,\s ^{-1}\,.$}{figure.caption.24}{}}
\newlabel{fig:u-analytical-loglog}{{8}{9}{Full numerical phase-boundary speed $u(0^-)$ in $\m \,\s ^{-1}$ as a function of the upstream baryon density and temperature, with $T(0^+)=0.1\,\MeV $ and $n_B^{\rm crit}(T{=}0)=3n_0\,.$ The white band is the domain in which the moving-front solution exists. Below the lower boundary neutron matter is stable against the assumed conversion, while the region with $A_{\rm adb}\geq 1$ lies outside the weak-interaction-limited branch described by our model. The contours are drawn at $50\,,$ $100\,,$ $200\,,$ $500\,,$ $1000\,,$ $2000\,,$ and $5000\,\m \,\s ^{-1}\,.$}{figure.caption.24}{}}
\newlabel{fig:T_vs_nB0-}{{8}{9}{Full numerical phase-boundary speed $u(0^-)$ in $\m \,\s ^{-1}$ as a function of the upstream baryon density and temperature, with $T(0^+)=0.1\,\MeV $ and $n_B^{\rm crit}(T{=}0)=3n_0\,.$ The white band is the domain in which the moving-front solution exists. Below the lower boundary neutron matter is stable against the assumed conversion, while the region with $A_{\rm adb}\geq 1$ lies outside the weak-interaction-limited branch described by our model. The contours are drawn at $50\,,$ $100\,,$ $200\,,$ $500\,,$ $1000\,,$ $2000\,,$ and $5000\,\m \,\s ^{-1}\,.$}{figure.caption.24}{}}
