\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Dependence of the numerical phase-boundary speed on the prescribed interface temperature $T(0^+)$. Panel (a) shows $u(0^-)$ as a function of $n_B(0^-)$ at fixed $T(0^-)=20\,\text  {MeV}$, while panel (b) shows $u(0^-)$ as a function of $T(0^-)$ at fixed $n_B(0^-)=3.5n_0$. The velocity axis is logarithmic, the markers denote the numerical slice samples, and the line color runs from colder (purple and blue) to hotter (red) values of $T(0^+)$. The gray regions are excluded in the corresponding slice by stable neutron matter or by $A_{\rm  adb}\geq 1$.}}{13}{figure.caption.30}\protected@file@percent }
\newlabel{fig:numerical-contour-compare}{{7}{13}{Dependence of the numerical phase-boundary speed on the prescribed interface temperature $T(0^+)$. Panel (a) shows $u(0^-)$ as a function of $n_B(0^-)$ at fixed $T(0^-)=20\,\MeV $, while panel (b) shows $u(0^-)$ as a function of $T(0^-)$ at fixed $n_B(0^-)=3.5n_0$. The velocity axis is logarithmic, the markers denote the numerical slice samples, and the line color runs from colder (purple and blue) to hotter (red) values of $T(0^+)$. The gray regions are excluded in the corresponding slice by stable neutron matter or by $A_{\rm adb}\geq 1$}{figure.caption.30}{}}
