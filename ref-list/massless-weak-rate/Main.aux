\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Absolute net quark-channel rates for the four local-rate models, at \(\mu _B=900\) and \(1200\,\mathrm  {MeV}\) and fixed compositions \(a=0.146,0.5,0.9\). Black is the exact phase-space integral, blue is Madsen's Eq.~(23), orange is the derived \(T^0+T^2\) rate, and green is Eq.~(23) with \(\mu _u^5\to (\mu _B/3)^5\). All values are in natural units. The black and orange curves nearly coincide at low temperature; their separation at higher temperature measures the truncation error.}}{13}{figure.1}\protected@file@percent }
\newlabel{fig:exact-rates}{{1}{13}{Absolute net quark-channel rates for the four local-rate models, at \(\mu _B=900\) and \(1200\,\MeV \) and fixed compositions \(a=0.146,0.5,0.9\). Black is the exact phase-space integral, blue is Madsen's Eq.~(23), orange is the derived \(T^0+T^2\) rate, and green is Eq.~(23) with \(\mu _u^5\to (\mu _B/3)^5\). All values are in natural units. The black and orange curves nearly coincide at low temperature; their separation at higher temperature measures the truncation error}{figure.1}{}}
\newlabel{fig:exact-rates@cref}{{[figure][1][]1}{[1][12][]13}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Relative local-rate errors, \(100(\Gamma _K/\Gamma _{K,\mathrm  {exact}}-1)\), at fixed neutral composition and \(\mu _B=900\,\mathrm  {MeV}\). The exact phase-space integral (black) defines zero error; blue is Madsen's Eq.~(23), orange is the derived \(T^0+T^2\) rate, and green is Eq.~(23) with \(\mu _u^5\to (\mu _B/3)^5\). The vertical scale is linear within \(1\%\) of zero and logarithmic outside that range. Lines connect the eight tested temperatures; they are not additional validation points.}}{14}{figure.2}\protected@file@percent }
\newlabel{fig:errors-900}{{2}{14}{Relative local-rate errors, \(100(\Gamma _K/\Gamma _{K,\mathrm {exact}}-1)\), at fixed neutral composition and \(\mu _B=900\,\MeV \). The exact phase-space integral (black) defines zero error; blue is Madsen's Eq.~(23), orange is the derived \(T^0+T^2\) rate, and green is Eq.~(23) with \(\mu _u^5\to (\mu _B/3)^5\). The vertical scale is linear within \(1\%\) of zero and logarithmic outside that range. Lines connect the eight tested temperatures; they are not additional validation points}{figure.2}{}}
\newlabel{fig:errors-900@cref}{{[figure][2][]2}{[1][12][]14}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The same comparison as \cref  {fig:errors-900}, at \(\mu _B=1200\,\mathrm  {MeV}\). Raising the chemical-potential scale reduces \(T/\mu _B\) at fixed dimensional temperature; the resulting error need not decrease monotonically outside the low-temperature regime.}}{15}{figure.3}\protected@file@percent }
\newlabel{fig:errors-1200}{{3}{15}{The same comparison as \cref {fig:errors-900}, at \(\mu _B=1200\,\MeV \). Raising the chemical-potential scale reduces \(T/\mu _B\) at fixed dimensional temperature; the resulting error need not decrease monotonically outside the low-temperature regime}{figure.3}{}}
\newlabel{fig:errors-1200@cref}{{[figure][3][]3}{[1][12][]15}}
