\newlabel{tab:adiabatic-verification}{{6}{22}{Observed relative numerical changes for the cold-interface adiabatic sensitivity calculation, taking the maximum absolute value over the tested compositions and rate models. Cutoffs are specified by \(T_{\rm cut}/T(\infty )\); uncorrected rows intentionally omit the cold contribution and are not acceptance checks. Every independent, refined, and corrected speed ratio agrees within the required relative tolerance \(10^{-3}\)}{table.6}{}}
\newlabel{tab:adiabatic-verification@cref}{{[table][6][]6}{[1][22][]22}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Adiabatic rate-integral speed estimates over upstream QMC-RMF3 neutron-matter states, with \(T(0^+)=0\) and the conserved EOS trajectory. Blue dashed contours give the Eq.~(23) estimate divided by the exact phase-space estimate, with local diffusion inside \(I_2\); by massless scaling each contour is a line of constant \(a(0^+)\). Black lines are the boundaries \(a(0^+)=0\) and \(a(0^+)=1\); the shaded regions have no cold-interface front. The derived \(T^0+T^2\) ratio is at most \(1.0083\) at every computed composition and is not contoured. Contours are interpolated from the upstream grid described in the text, whose density range starts at \(n_0\).}}{23}{figure.5}\protected@file@percent }
\newlabel{fig:adiabatic-speed}{{5}{23}{Adiabatic rate-integral speed estimates over upstream QMC-RMF3 neutron-matter states, with \(T(0^+)=0\) and the conserved EOS trajectory. Blue dashed contours give the Eq.~(23) estimate divided by the exact phase-space estimate, with local diffusion inside \(I_2\); by massless scaling each contour is a line of constant \(a(0^+)\). Black lines are the boundaries \(a(0^+)=0\) and \(a(0^+)=1\); the shaded regions have no cold-interface front. The derived \(T^0+T^2\) ratio is at most \(1.0083\) at every computed composition and is not contoured. Contours are interpolated from the upstream grid described in the text, whose density range starts at \(n_0\)}{figure.5}{}}
\newlabel{fig:adiabatic-speed@cref}{{[figure][5][]5}{[1][22][]23}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces A representative conserved trajectory at \(T(0^-)=20\,\mathrm  {MeV}\) and \(a(0^+)=0.9\). The upper panels show temperature and local diffusion; diffusion diverges at the cold interface. The lower left panel shows each weighted integrand \((D_K\Gamma _K/n_B)|\mathrm  da/\mathrm  dz|\) relative to the exact one, in percent on a linear scale within \(1\%\) of zero and logarithmic outside it. Because \(D_K\) and the Jacobian are common to all models, this is the local rate error along the path; it is finite at the cold limit \(z=0\). Green is Eq.~(23) with \(\mu _u^5\to (\mu _B/3)^5\). The lower right panel shows the contribution accumulated from equilibrium to the indicated composition, normalized separately by each model's total \(I_2\). Curves connect quadrature samples.}}{24}{figure.6}\protected@file@percent }
\newlabel{fig:adiabatic-diagnostics}{{6}{24}{A representative conserved trajectory at \(T(0^-)=20\,\MeV \) and \(a(0^+)=0.9\). The upper panels show temperature and local diffusion; diffusion diverges at the cold interface. The lower left panel shows each weighted integrand \((D_K\Gamma _K/n_B)|\dd a/\dd z|\) relative to the exact one, in percent on a linear scale within \(1\%\) of zero and logarithmic outside it. Because \(D_K\) and the Jacobian are common to all models, this is the local rate error along the path; it is finite at the cold limit \(z=0\). Green is Eq.~(23) with \(\mu _u^5\to (\mu _B/3)^5\). The lower right panel shows the contribution accumulated from equilibrium to the indicated composition, normalized separately by each model's total \(I_2\). Curves connect quadrature samples}{figure.6}{}}
\newlabel{fig:adiabatic-diagnostics@cref}{{[figure][6][]6}{[1][22][]24}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Local-diffusion and constant-diffusion comparisons on identical adiabatic EOS trajectories. In the right panel, a common constant diffusion coefficient cancels from the ratio. Both panels retain the temperature rise and varying flavor chemical potentials. All three rate prescriptions follow the same color and line conventions as Figure~\ref {fig:speed-sensitivity}.}}{25}{figure.7}\protected@file@percent }
\newlabel{fig:adiabatic-diffusion}{{7}{25}{Local-diffusion and constant-diffusion comparisons on identical adiabatic EOS trajectories. In the right panel, a common constant diffusion coefficient cancels from the ratio. Both panels retain the temperature rise and varying flavor chemical potentials. All three rate prescriptions follow the same color and line conventions as Figure~\ref {fig:speed-sensitivity}}{figure.7}{}}
\newlabel{fig:adiabatic-diffusion@cref}{{[figure][7][]7}{[1][22][]25}}
